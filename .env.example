# AegisCorp OS Environment Variables
AEGISCORP_ENV=development
AEGISCORP_PORT=8000
AEGISCORP_HOST=0.0.0.0
AEGISCORP_DB_PATH=aegiscorp_state.db

# LLM Providers (Defaults to deterministic local simulation with 0 API keys required)
DEFAULT_LLM_PROVIDER=deterministic

# Free Tier Providers (See docs/FREE_LLM_PROVIDERS.md)
GROQ_API_KEY=
OPENROUTER_API_KEY=
GITHUB_TOKEN=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Security & Governance
GOVERNANCE_STRICT_MODE=true
AUTO_APPROVE_BELOW_1M=false
ENABLE_WEB_RESEARCH=true
